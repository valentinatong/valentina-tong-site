---
// Bio: nome, texto (PT/EN) e e-mail de contato.
import {client, rico, temTexto, type Lang} from '../lib/sanity'
interface Props { lang: Lang }
const {lang} = Astro.props
const b = (await client.fetch(`*[_id=="bio"][0]`)) || {}
---
<main class="bio">
  <h1>{b.nome || 'Valentina Tong'}</h1>
  {temTexto(b.texto) && <Fragment set:html={rico(b.texto, lang, {paragrafos: true})} />}
  {b.email && <div class="contact"><a href={`mailto:${b.email}`}>{b.email}</a></div>}
</main>
<style is:global>
  main.bio{ max-width:60ch; margin:6vh auto 16vh; padding:0 40px; }
  main.bio h1{ font-family:var(--title-font); font-weight:500; font-size:32px; margin:0 0 5vh; }
  main.bio p{ font-size:16px; line-height:1.7; margin:0 0 1.4em; }
  main.bio p em{ color:var(--stone); }
  main.bio a{ text-decoration:underline; text-underline-offset:3px; }
  main.bio .contact{ margin-top:5vh; padding-top:3vh; border-top:1px solid var(--line); font-family:var(--mono-font); font-size:12px; letter-spacing:.06em; color:var(--stone); }
  main.bio .contact a{ color:var(--ink); text-decoration:none; border-bottom:1px solid var(--line); }
  main.bio .contact a:hover{ color:var(--oxide); border-color:var(--oxide); }
  @media (max-width:800px){ main.bio{ padding:0 22px; } }
</style>
