---
// Home: menu nos quatro cantos (nome, EN, Curadoria, Bio), lista de projetos no centro com a foto ao lado
// (troca ao passar o mouse) e o Atlas Fotográfico como uma faixa azul na borda direita — ao clicar, ela
// cresce para a esquerda até cobrir a tela, como um portal, e só então abre o Atlas (que tem o mesmo azul).
import {projetos, img, hex, tintaPara, configProjetos, type Lang} from '../lib/sanity'
import {caixaFoto} from '../lib/recorte'
interface Props { lang: Lang }
const {lang} = Astro.props
const pre = lang === 'en' ? '/en' : ''
// tamanhos da lista (nomes e datas): "Configurações dos Projetos" no Sanity
const cfg = await configProjetos()
const tamNome = Number(cfg.tamanhoListaHome) ? `${Number(cfg.tamanhoListaHome)}px` : 'clamp(17px, 1.65vw, 24px)'
const tamData = `${Number(cfg.tamanhoDataHome) || 12}px`
const lista = await Promise.all((await projetos()).map(async (p: any) => {
  const g = p.capa?.asset ? p.capa : p.primeira
  let foto = ''
  if (g?.asset) {
    const cx = p.capa?.asset ? null : await caixaFoto(g, hex(p.corFundo, '#ebebeb').replace('#', ''))
    foto = (cx ? img(g).rect(...cx) : img(g)).width(1000).quality(82).url()
  }
  const bg = hex(p.corFundo, '#e9e6df')
  return {nome: p.nome, ano: p.ano, slug: p.slug, foto, bg, ink: tintaPara(bg) === 'claro' ? '#f4f1ea' : '#201D19'}
}))
const t = lang === 'en'
  ? {cur: 'CURATORSHIP', bio: 'BIO', outra: 'PT', outraHref: '/', atlas: 'PHOTOGRAPHIC ATLAS'}
  : {cur: 'CURADORIA', bio: 'BIO', outra: 'EN', outraHref: '/en/', atlas: 'ATLAS FOTOGRÁFICO'}
---
<nav class="linha" aria-label="Menu">
  <h1 class="nome-site">Valentina Tong</h1>
  <a class="on" href={`${pre}/`} aria-current="page">{lang === 'en' ? 'PROJECTS' : 'PROJETOS'}</a>
  <a href={`${pre}/curadoria/`}>{t.cur}</a>
  <a href={`${pre}/bio/`}>{t.bio}</a>
  <a class="lingua" href={t.outraHref}>{t.outra}</a>
</nav>

<main class="hm" style={`--tam-nome:${tamNome}; --tam-data:${tamData}`}>
  <div class="hm-centro">
  <div class="hm-foto" aria-hidden="true"><img id="hmFoto" alt="" /></div>
  <ul class="hm-lista" id="hmLista" aria-label={lang === 'en' ? 'Projects' : 'Projetos'}>
    {lista.map((p: any) => (
      <li><a href={`${pre}/projetos/${p.slug}/`} data-foto={p.foto} data-bg={p.bg} data-ink={p.ink}><span class="yr">{p.ano}</span><span class="nm">{p.nome}</span></a></li>
    ))}
  </ul>
  </div>
</main>


<script is:inline>
(function () {
  // foto troca ao passar o mouse num projeto
  var lista = document.getElementById('hmLista'), foto = document.getElementById('hmFoto'), atual = null;
  var links = lista.querySelectorAll('a');
  links.forEach(function (a) { if (a.dataset.foto) new Image().src = a.dataset.foto; });
  var vez = 0;
  function mostra(src) {
    if (!src || src === atual) return; atual = src; var v = ++vez;
    foto.style.opacity = 0;
    setTimeout(function () {
      if (v !== vez) return;
      foto.onload = function () { if (v === vez) foto.style.opacity = 1; };
      foto.src = src; if (foto.complete && foto.naturalWidth) foto.style.opacity = 1;
    }, 160);
  }
  function esconde() { vez++; atual = null; foto.style.opacity = 0; }
  // o fundo da página assume a cor do projeto
  var raiz = document.body.style;
  function cor(a) { raiz.setProperty('--bg', a.dataset.bg); raiz.setProperty('--ink', a.dataset.ink); raiz.setProperty('--stone', a.dataset.ink); }
  function volta() { raiz.setProperty('--bg', '#e9e6df'); raiz.setProperty('--ink', '#201D19'); raiz.setProperty('--stone', '#6f6a5c'); }
  links.forEach(function (a) {
    a.addEventListener('mouseenter', function () { mostra(a.dataset.foto); cor(a); });
    a.addEventListener('focus', function () { mostra(a.dataset.foto); cor(a); });
  });
  // a home abre já com o primeiro projeto (foto e cor de fundo); ao sair da lista, volta para ele
  var primeiro = links[0];
  function capa() { if (primeiro) { mostra(primeiro.dataset.foto); cor(primeiro); } }
  capa();
  lista.addEventListener('mouseleave', function () { capa(); });
})();
</script>

<style is:global>
  body.home{ --bg:#e9e6df; background:var(--bg); min-height:100vh; padding-right:0; transition:background-color .45s ease, color .45s ease; }
  body.home .hc, body.home .hm-lista a, body.home .hm-lista .yr{ transition:color .45s ease, opacity .25s; }

  /* nome no início do menu */
  .linha .nome-site{ margin:0 14px 0 0; font-family:var(--title-font); font-weight:500; font-size:17px; letter-spacing:0; line-height:1; color:var(--ink); transition:color .45s ease; }
  .hm{ min-height:100vh; display:flex; align-items:center; justify-content:center; gap:6vw; padding:90px calc(var(--spine) + 60px) 90px 60px; box-sizing:border-box; }
  /* a lista fica no centro; a foto surge à esquerda dela, sem empurrar a lista */
  /* conjunto foto + lista centralizado: a lista anda para a direita metade da (largura da foto + espaço entre elas) */
  /* assimetria: a lista fica 1/3 da altura da foto mais baixa que a foto (o deslocamento vertical da lista — 5/12 da foto menos 1/4 da própria altura — centraliza na tela o conjunto inteiro: do topo da foto ao pé da lista) */
  .hm{ --hm-f:min(30vw, 60vh); }
  .hm-centro{ position:relative; transform:translate(calc((var(--hm-f) + 5vw) / 2), calc(var(--hm-f) * 5 / 12 - 25%)); }
  .hm-foto{ position:absolute; right:calc(100% + 5vw); top:50%; transform:translateY(calc(-50% - var(--hm-f) / 3)); width:min(30vw, 60vh); height:min(30vw, 60vh); display:flex; align-items:center; justify-content:flex-end; pointer-events:none; }
  .hm-foto img{ max-width:100%; max-height:100%; display:block; opacity:0; transition:opacity .25s ease; }
  .hm-lista{ list-style:none; margin:0; padding:0; }
  .hm-lista a{ display:grid; grid-template-columns:calc(var(--tam-data, 12px) * 5 + 12px) auto; align-items:baseline; width:max-content; padding:1px 0; color:var(--ink); transition:opacity .25s; }
  .hm-lista:hover a{ opacity:.3; } .hm-lista a:hover, .hm-lista a:focus-visible{ opacity:1; outline:none; }
  .hm-lista .yr{ font-family:var(--mono-font); font-size:var(--tam-data, 12px); letter-spacing:.04em; color:var(--stone); }
  .hm-lista .nm{ font-family:var(--title-font); font-weight:400; font-size:var(--tam-nome, clamp(17px, 1.65vw, 24px)); line-height:1.3; letter-spacing:-.005em; white-space:nowrap; }

  @media (max-width:760px){
    .hc-tl{ top:20px; left:16px; } .hc-tr{ top:20px; right:16px; }
    .hc-bl, .hc-br{ display:none; }
    .hm-rodape .hc{ position:static; }
    .hm{ flex-direction:column; align-items:stretch; gap:28px; padding:104px 16px 40px; }
    .hm-foto{ position:static; transform:none; width:100%; height:auto; justify-content:center; margin:0 0 4px; }
    .hm-foto img{ max-height:42vh; }
    .linha .nome-site{ flex-basis:100%; margin:0 0 2px; text-align:center; }
    body.home .linha{ position:absolute; }  /* no celular o menu rola junto, para não passar por cima da foto */
    .hm-centro{ transform:none; }
    .hm-lista a{ width:auto; grid-template-columns:52px 1fr; padding:3px 0; }
    .hm-lista .nm{ white-space:normal; font-size:20px; }
    .hm-rodape{ display:flex; justify-content:space-between; padding:0 16px 90px; }
  }
</style>
