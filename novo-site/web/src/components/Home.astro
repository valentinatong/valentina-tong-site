---
// Home: foto de capa em tela cheia e o menu no centro.
import {client, img, type Lang} from '../lib/sanity'
interface Props { lang: Lang }
const {lang} = Astro.props
const pre = lang === 'en' ? '/en' : ''
const h = await client.fetch(`*[_id=="home"][0]{foto}`)
const foto = h?.foto?.asset ? h.foto : null
const itens = lang === 'en'
  ? [['Projects', '/projetos/'], ['Photographic Atlas', '/atlas/'], ['Curatorship', '/curadoria/'], ['Bio', '/bio/']]
  : [['Projetos', '/projetos/'], ['Atlas Fotográfico', '/atlas/'], ['Curadoria', '/curadoria/'], ['Bio', '/bio/']]
---
{foto && (
  <picture>
    <source media="(max-width:640px)" srcset={img(foto).width(900).height(1600).url()} />
    <img class="vt-photo" src={img(foto).width(2400).url()} alt="" />
  </picture>
)}
<div class="vt-veil"></div>
<nav class="vt-center" aria-label={lang === 'en' ? 'Main menu' : 'Menu principal'}>
  {itens.map(([nome, href]) => <a href={`${pre}${href}`}>{nome}</a>)}
</nav>
<a class="vt-lang" href={lang === 'en' ? '/' : '/en/'}>{lang === 'en' ? 'PT' : 'EN'}</a>

<style is:global>
  body.home{ background:var(--ink); overflow:hidden; height:100vh; }
  .vt-photo{ position:fixed; inset:0; width:100%; height:100%; object-fit:cover; display:block; }
  /* leve escurecida atrás do menu, para ele ficar legível sobre qualquer foto */
  .vt-veil{ position:fixed; inset:0; background:radial-gradient(ellipse 620px 200px at 50% 50%, rgba(0,0,0,.38), rgba(0,0,0,0) 70%); pointer-events:none; }
  nav.vt-center{ position:fixed; left:50%; top:50%; transform:translate(-50%,-50%); display:flex; align-items:center; gap:clamp(28px,4vw,52px); z-index:2; }
  nav.vt-center a, .vt-lang{ font-family:var(--mono-font); font-size:13px; letter-spacing:.16em; text-transform:uppercase; color:#FBFAF7; transition:color .2s ease; white-space:nowrap; }
  nav.vt-center a:hover, .vt-lang:hover{ color:var(--oxide); }
  .vt-lang{ position:fixed; top:18px; right:24px; z-index:2; font-size:11px; opacity:.8; }
  @media (max-width:640px){ nav.vt-center{ flex-direction:column; gap:18px; text-align:center; } }
</style>
