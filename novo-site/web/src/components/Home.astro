---
// Home: menu nos quatro cantos (nome, EN, Curadoria, Bio), lista de projetos no centro com a foto ao lado
// (troca ao passar o mouse) e o Atlas Fotográfico como uma faixa azul na borda direita — ao clicar, ela
// cresce para a esquerda até cobrir a tela, como um portal, e só então abre o Atlas (que tem o mesmo azul).
import {projetos, img, hex, tintaPara, type Lang} from '../lib/sanity'
import {caixaFoto} from '../lib/recorte'
interface Props { lang: Lang }
const {lang} = Astro.props
const pre = lang === 'en' ? '/en' : ''
const lista = await Promise.all((await projetos()).map(async (p: any) => {
  const g = p.capa?.asset ? p.capa : p.primeira
  let foto = ''
  if (g?.asset) {
    const cx = p.capa?.asset ? null : await caixaFoto(g, hex(p.corFundo, '#ebebeb').replace('#', ''))
    foto = (cx ? img(g).rect(...cx) : img(g)).width(1000).quality(82).url()
  }
  const bg = hex(p.corFundo, '#e9e6df')
  return {nome: p.nome, ano: p.ano, slug: p.slug, foto, bg, ink: tintaPara(bg) === 'claro' ? '#f4f1ea' : '#201D19'}
}))
const t = lang === 'en'
  ? {cur: 'CURATORSHIP', bio: 'BIO', outra: 'PT', outraHref: '/', atlas: 'PHOTOGRAPHIC ATLAS'}
  : {cur: 'CURADORIA', bio: 'BIO', outra: 'EN', outraHref: '/en/', atlas: 'ATLAS FOTOGRÁFICO'}
---
<a class="hc hc-tl on" href={`${pre}/`} aria-current="page">VALENTINA TONG</a>
<a class="hc hc-tr" href={t.outraHref}>{t.outra}</a>
<a class="hc hc-bl" href={`${pre}/curadoria/`}>{t.cur}</a>
<a class="hc hc-br" href={`${pre}/bio/`}>{t.bio}</a>

<main class="hm">
  <div class="hm-foto" aria-hidden="true"><img id="hmFoto" src={lista[0]?.foto} alt="" /></div>
  <ul class="hm-lista" id="hmLista" aria-label={lang === 'en' ? 'Projects' : 'Projetos'}>
    {lista.map((p: any) => (
      <li><a href={`${pre}/projetos/${p.slug}/`} data-foto={p.foto} data-bg={p.bg} data-ink={p.ink}><span class="yr">{p.ano}</span><span class="nm">{p.nome}</span></a></li>
    ))}
  </ul>
</main>
<nav class="hm-rodape"><a class="hc" href={`${pre}/curadoria/`}>{t.cur}</a><a class="hc" href={`${pre}/bio/`}>{t.bio}</a></nav>


<script is:inline>
(function () {
  // foto troca ao passar o mouse num projeto
  var lista = document.getElementById('hmLista'), foto = document.getElementById('hmFoto'), atual = foto.getAttribute('src');
  var links = lista.querySelectorAll('a');
  links.forEach(function (a) { if (a.dataset.foto) new Image().src = a.dataset.foto; });
  function mostra(src) {
    if (!src || src === atual) return; atual = src;
    foto.style.opacity = 0;
    setTimeout(function () { foto.src = src; foto.onload = function () { foto.style.opacity = 1; }; }, 160);
  }
  // o fundo da página assume a cor do projeto
  var raiz = document.body.style;
  function cor(a) { raiz.setProperty('--bg', a.dataset.bg); raiz.setProperty('--ink', a.dataset.ink); raiz.setProperty('--stone', a.dataset.ink); }
  function volta() { raiz.setProperty('--bg', '#e9e6df'); raiz.setProperty('--ink', '#201D19'); raiz.setProperty('--stone', '#6f6a5c'); }
  links.forEach(function (a) {
    a.addEventListener('mouseenter', function () { mostra(a.dataset.foto); cor(a); });
    a.addEventListener('focus', function () { mostra(a.dataset.foto); cor(a); });
  });
  lista.addEventListener('mouseleave', volta);
})();
</script>

<style is:global>
  body.home{ --bg:#e9e6df; background:var(--bg); min-height:100vh; padding-right:0; transition:background-color .45s ease, color .45s ease; }
  body.home .hc, body.home .hm-lista a, body.home .hm-lista .yr{ transition:color .45s ease, opacity .25s; }

  .hm{ min-height:100vh; display:flex; align-items:center; justify-content:center; gap:6vw; padding:90px calc(var(--spine) + 60px) 90px 60px; box-sizing:border-box; }
  .hm-foto{ width:min(34vw, 64vh); height:min(34vw, 64vh); flex:none; display:flex; align-items:center; justify-content:center; }
  .hm-foto img{ max-width:100%; max-height:100%; display:block; transition:opacity .25s ease; }
  .hm-lista{ list-style:none; margin:0; padding:0; }
  .hm-lista a{ display:grid; grid-template-columns:62px auto; align-items:baseline; width:max-content; padding:1px 0; color:var(--ink); transition:opacity .25s; }
  .hm-lista:hover a{ opacity:.3; } .hm-lista a:hover, .hm-lista a:focus-visible{ opacity:1; outline:none; }
  .hm-lista .yr{ font-family:var(--mono-font); font-size:10px; letter-spacing:.04em; color:var(--stone); }
  .hm-lista .nm{ font-family:var(--title-font); font-weight:400; font-size:clamp(17px, 1.65vw, 24px); line-height:1.3; letter-spacing:-.005em; white-space:nowrap; }

  @media (max-width:760px){
    .hc-tl{ top:20px; left:16px; } .hc-tr{ top:20px; right:16px; }
    .hc-bl, .hc-br{ display:none; }
    .hm-rodape .hc{ position:static; }
    .hm{ flex-direction:column; align-items:stretch; gap:28px; padding:70px 16px 40px; }
    .hm-foto{ width:100%; height:62vw; }
    .hm-lista a{ width:auto; grid-template-columns:52px 1fr; padding:3px 0; }
    .hm-lista .nm{ white-space:normal; font-size:20px; }
    .hm-rodape{ display:flex; justify-content:space-between; padding:0 16px 90px; }
  }
</style>
