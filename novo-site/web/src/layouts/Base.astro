---
// Página-mestre: cabeçalho, menu, PT/EN, fontes e cores — usada por todas as páginas.
// sem 'cabecalho': menu flutuante no canto (páginas de Projetos), sem a faixa de título.
// semMenu: a página desenha o próprio topo (Atlas e Mapa).
import {menu as menuDe, atlasLink} from '../lib/menu'
interface Props { titulo: string; cabecalho?: string; ativo: string; lang: 'pt' | 'en'; outraLingua: string; cores?: Record<string, string>; semMenu?: boolean; classe?: string }
const {titulo, cabecalho, ativo, lang, outraLingua, cores = {}, semMenu = false, classe} = Astro.props
const menu = menuDe(lang)
const atlas = atlasLink(lang)
const estilo = Object.entries(cores).map(([k, v]) => `${k}:${v}`).join(';')
// horário da geração do site (para conferir se o Publicar do Sanity reconstruiu)
const geradoEm = new Date().toISOString()
---
<!doctype html>
<html lang={lang === 'en' ? 'en' : 'pt-BR'} style={estilo}>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="gerado-em" content={geradoEm} />
<title>{titulo === "Valentina Tong" ? titulo : `${titulo} — Valentina Tong`}</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;1,6..72,400;1,6..72,500;1,6..72,600&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />
<link rel="preconnect" href="https://cdn.sanity.io" />
<slot name="head" />
<style is:global>
  :root{
    --bg:#ffffff; --ink:#201D19; --stone:#6f6a5c; --stone-dim:#a49d8f; --oxide:#9A4A2C; --card:#ffffff; --cell:transparent;
    --line:rgba(32,29,25,.14);
    --title-font:"Fraunces", Georgia, serif;
    --body-font:"Newsreader", Georgia, serif;
    --mono-font:"Space Mono", ui-monospace, monospace;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{ background:var(--bg); color:var(--ink); font-family:var(--body-font); -webkit-font-smoothing:antialiased; }
  a{color:inherit;text-decoration:none;}
  .top{ display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:18px 24px; padding:20px 40px 22px; }
  .top .h{ flex-basis:100%; font-family:var(--mono-font); font-size:12px; letter-spacing:.2em; color:var(--ink); margin-top:14px; }
  /* Atlas Fotográfico: botão no azul do Atlas, separado do menu, sempre à direita — porta para outro universo */
  .atlas-btn{ display:inline-flex; align-items:center; gap:12px; background:#080D63; color:#EDEAE2 !important; font-family:var(--mono-font); font-size:11px; letter-spacing:.14em;
    padding:9px 14px; line-height:1; white-space:nowrap; transition:background .2s ease; }
  .atlas-btn:hover{ background:#141b8a; }
  .atlas-btn span{ transition:transform .2s ease; } .atlas-btn:hover span{ transform:translateX(3px); }
  nav.main{ display:flex; gap:26px; font-family:var(--mono-font); font-size:11px; letter-spacing:.14em; }
  nav.main a{ color:var(--stone); } nav.main a:hover{ color:var(--ink); } nav.main a.on{ color:var(--ink); border-bottom:1px solid var(--oxide); padding-bottom:3px; }
  @media (max-width:800px){ .top{ padding:18px 16px; } .top nav.main{ flex-wrap:wrap; gap:10px 16px; } }
  /* menu flutuante (Projetos) */
  .pillars{ position:fixed; top:16px; left:26px; right:26px; z-index:41; display:flex; align-items:center; gap:22px;
    font-family:var(--mono-font); font-size:11px; letter-spacing:.14em; transition:opacity .18s linear; }
  .pillars a{ color:var(--stone); } .pillars a:hover{ color:var(--ink); }
  .pillars a.on{ color:var(--ink); border-bottom:1px solid var(--oxide); padding-bottom:3px; }
  .pillars .atlas-btn, .top .atlas-btn{ margin-left:auto; }
  @media (max-width:760px){ .pillars{ left:16px; right:16px; flex-wrap:wrap; gap:10px 16px; } }
  /* menu nos quatro cantos (home, Curadoria, Bio) */
  /* menu numa linha só, no topo à esquerda (o mesmo menu em todas as páginas) */
  .linha, .pillars{ position:fixed; top:28px; left:40px; z-index:45; display:flex; align-items:center; gap:30px;
    font-family:var(--mono-font); font-size:12px; letter-spacing:.16em; }
  .linha a, .pillars a{ color:var(--ink); transition:color .45s ease, opacity .2s; }
  .linha a:hover, .pillars a:hover{ opacity:.6; }
  .linha a.on{ border-bottom:1px solid var(--oxide); padding-bottom:3px; }
  /* troca de idioma (EN/PT): dentro de um círculo de linha leve */
  .linha a.lingua, .pillars a.lingua{ display:inline-flex; align-items:center; justify-content:center; width:2.6em; height:2.6em; margin:-.8em 0; box-sizing:border-box;
    padding-left:.16em; border:1px solid color-mix(in srgb, currentColor 35%, transparent); border-radius:50%; }
  @media (max-width:760px){ .linha, .pillars{ top:20px; left:16px; right:16px; gap:10px 20px; flex-wrap:wrap; justify-content:center; font-size:13px; } }
  .hc{ position:fixed; z-index:45; font-family:var(--mono-font); font-size:11px; letter-spacing:.16em; color:var(--stone); transition:color .2s; }
  .hc:hover, .hc.on{ color:var(--ink); }
  .hc.on{ border-bottom:1px solid var(--oxide); padding-bottom:3px; }
  .hc-tl{ top:30px; left:40px; color:var(--ink); }
  .hc-tr{ top:30px; right:calc(var(--spine, 0px) + 32px); }
  .hc-bl{ bottom:30px; left:40px; }
  .hc-br{ bottom:30px; right:calc(var(--spine, 0px) + 32px); }
  .cantos-pg{ padding-top:70px; padding-bottom:70px; }
  .sr-only{ position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap; }
  /* faixas no topo e no pé para o conteúdo passar por baixo dos cantos */
  .cantos-pg::before, .cantos-pg::after{ content:''; position:fixed; left:0; right:var(--spine, 0px); z-index:44; pointer-events:none; }
  .cantos-pg::before{ top:0; height:66px; background:linear-gradient(var(--bg) 70%, transparent); }
  .cantos-pg::after{ bottom:0; height:76px; background:linear-gradient(to top, var(--bg) 62%, transparent); }
  @media (max-width:760px){
    .hc-tl{ top:20px; left:16px; } .hc-tr{ top:20px; right:16px; }
    .hc-bl{ bottom:16px; left:16px; } .hc-br{ bottom:16px; right:16px; }
    .cantos-pg{ padding-top:52px; }
    .cantos-pg::before{ height:50px; } .cantos-pg::after{ height:56px; }
    .cantos-pg.com-portal .hc-bl, .cantos-pg.com-portal .hc-br{ bottom:50px; }
    .cantos-pg.com-portal::after{ bottom:36px; }
    .cantos-pg.com-portal{ padding-bottom:96px; }
  }
  /* faixa do Atlas na borda direita (computador): ao clicar, cresce para a esquerda como um portal */
  body.com-portal{ --spine:40px; padding-right:var(--spine); }
  body.com-portal .atlas-btn{ display:none; }
  body.com-portal .pillars{ right:calc(var(--spine) + 26px); }
  .portal{ position:fixed; z-index:60; top:0; right:0; bottom:0; width:var(--spine, 40px); background:#080D63; color:#EDEAE2;
    display:flex; flex-direction:column; align-items:center; justify-content:center; gap:18px; overflow:hidden;
    transition:width 1.5s cubic-bezier(.65,0,.25,1), background .2s; }
  .portal:hover{ background:#0d1478; }
  .portal .pt-txt{ writing-mode:vertical-rl; text-orientation:upright; font-family:var(--mono-font); font-size:12px; letter-spacing:.02em; line-height:1; white-space:nowrap; transition:opacity .25s; }
  .portal .pt-seta{ font-family:var(--mono-font); font-size:13px; transition:transform .25s, opacity .25s; }
  .portal:hover .pt-seta{ transform:translateX(3px); }
  .portal.abrindo{ width:100vw; background:#080D63; }
  .portal.abrindo .pt-txt, .portal.abrindo .pt-seta{ opacity:0; }
  .portal.fechando .pt-txt, .portal.fechando .pt-seta{ transition-delay:1.15s; }
  @media (max-width:760px){
    body.com-portal{ --spine:0px; padding-right:0; }
    body.com-portal .atlas-btn{ display:inline-flex; }
    body.com-portal .pillars{ right:16px; }
    .portal{ display:none; }
    body.home .portal, body.cantos-pg .portal{ display:flex; top:auto; left:0; width:auto; height:36px; flex-direction:row; transition:height 1.5s cubic-bezier(.65,0,.25,1); }
    body.home .portal .pt-seta, body.cantos-pg .portal .pt-seta{ order:1; }
    body.home .portal .pt-txt, body.cantos-pg .portal .pt-txt{ writing-mode:horizontal-tb; letter-spacing:.24em; font-size:11px; }
    body.home .portal.abrindo, body.cantos-pg .portal.abrindo{ width:auto; height:100vh; }
  }
</style>
<!-- Vercel Web Analytics: contagem de visitas sem cookies (ativar em Vercel → projeto → Analytics) -->
<script is:inline defer src="/_vercel/insights/script.js"></script>
</head>
<body class={[classe, ativo === 'home' && 'com-portal', cabecalho && !semMenu && 'cantos-pg'].filter(Boolean).join(' ')}>
  {semMenu ? null : cabecalho ? (
    <Fragment>
      <nav class="linha" aria-label={lang === 'en' ? 'Menu' : 'Menu'}>
        <a href={lang === 'en' ? '/en/' : '/'}>{lang === 'en' ? 'PROJECTS' : 'PROJETOS'}</a>
        <a class={ativo === 'curadoria' ? 'on' : undefined} href={lang === 'en' ? '/en/curadoria/' : '/curadoria/'}>{lang === 'en' ? 'CURATORSHIP' : 'CURADORIA'}</a>
        <a class={ativo === 'bio' ? 'on' : undefined} href={lang === 'en' ? '/en/bio/' : '/bio/'}>BIO</a>
        <a class="lingua" href={outraLingua}>{lang === 'en' ? 'PT' : 'EN'}</a>
      </nav>
      <h1 class="sr-only">{cabecalho}</h1>
    </Fragment>
  ) : (
    <nav class="pillars" id="pillars" aria-label={lang === 'en' ? 'Sections' : 'Pilares'}>
      <a href={lang === 'en' ? '/en/' : '/'}>{lang === 'en' ? 'PROJECTS' : 'PROJETOS'}</a>
      <a href={lang === 'en' ? '/en/curadoria/' : '/curadoria/'}>{lang === 'en' ? 'CURATORSHIP' : 'CURADORIA'}</a>
      <a href={lang === 'en' ? '/en/bio/' : '/bio/'}>BIO</a>
      <a class="pl-lang lingua" href={outraLingua}>{lang === 'en' ? 'PT' : 'EN'}</a>
    </nav>
  )}
  <slot />
  {ativo === 'home' && (
    <a class="portal" id="portal" href={atlas.href}><span class="pt-seta" aria-hidden="true">→</span><span class="pt-txt">{atlas.nome}</span></a>
    <script is:inline>
    (function () {
      var portal = document.getElementById('portal');
      // vindo do Atlas pelo "← Valentina Tong": a página abre com o portal aberto e ele se fecha para a direita
      try {
        if (sessionStorage.getItem('vt-fecha')) {
          sessionStorage.removeItem('vt-fecha');
          portal.style.transition = 'none'; portal.classList.add('abrindo'); portal.offsetWidth;
          portal.classList.add('fechando');
          requestAnimationFrame(function () { requestAnimationFrame(function () { portal.style.transition = ''; portal.classList.remove('abrindo'); }); });
          setTimeout(function () { portal.classList.remove('fechando'); }, 1700);
        }
      } catch (e) {}
      portal.addEventListener('click', function (e) {
        if (e.metaKey || e.ctrlKey || e.shiftKey || getComputedStyle(portal).display === 'none') return;
        e.preventDefault(); portal.classList.add('abrindo');
        setTimeout(function () { location.href = portal.href; }, 1520);
      });
      addEventListener('pageshow', function (e) { if (e.persisted) portal.classList.remove('abrindo'); });
      var l = document.createElement('link'); l.rel = 'prefetch'; l.href = portal.href; document.head.appendChild(l);
    })();
    </script>
  )}
  <script is:inline src="/no-drag.js"></script>
</body>
</html>
