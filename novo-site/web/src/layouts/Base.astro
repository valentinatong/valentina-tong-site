---
// Página-mestre: cabeçalho, menu, PT/EN, fontes e cores — usada por todas as páginas.
interface Props { titulo: string; cabecalho: string; ativo: string; lang: 'pt' | 'en'; outraLingua: string; cores?: Record<string, string> }
const {titulo, cabecalho, ativo, lang, outraLingua, cores = {}} = Astro.props
const pre = lang === 'en' ? '/en' : ''
// páginas ainda não migradas apontam para o site antigo
const ANTIGO = 'https://valentina-tong-site.vercel.app'
const menu = [
  {id: 'home', pt: 'HOME', en: 'HOME', href: `${ANTIGO}/index.html`},
  {id: 'projetos', pt: 'PROJETOS', en: 'PROJECTS', href: `${ANTIGO}/projetos.html`},
  {id: 'atlas', pt: 'ATLAS FOTOGRÁFICO', en: 'PHOTOGRAPHIC ATLAS', href: `${ANTIGO}/arquivo.html`},
  {id: 'curadoria', pt: 'CURADORIA', en: 'CURATORSHIP', href: `${pre}/curadoria/`},
  {id: 'bio', pt: 'BIO', en: 'BIO', href: `${ANTIGO}/bio.html`},
]
const estilo = Object.entries(cores).map(([k, v]) => `${k}:${v}`).join(';')
---
<!doctype html>
<html lang={lang === 'en' ? 'en' : 'pt-BR'} style={estilo}>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{titulo} — Valentina Tong</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;1,6..72,400;1,6..72,500;1,6..72,600&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
<link rel="preconnect" href="https://cdn.sanity.io" />
<style is:global>
  :root{
    --bg:#ffffff; --ink:#201D19; --stone:#6f6a5c; --stone-dim:#a49d8f; --oxide:#9A4A2C; --card:#ffffff; --cell:transparent;
    --line:rgba(32,29,25,.14);
    --title-font:"Fraunces", Georgia, serif;
    --body-font:"Newsreader", Georgia, serif;
    --mono-font:"Space Mono", ui-monospace, monospace;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{ background:var(--bg); color:var(--ink); font-family:var(--body-font); -webkit-font-smoothing:antialiased; }
  a{color:inherit;text-decoration:none;}
  .top{ display:flex; align-items:baseline; justify-content:space-between; gap:24px; padding:26px 40px 22px; }
  .top .h{ font-family:var(--mono-font); font-size:12px; letter-spacing:.2em; color:var(--ink); }
  nav.main{ display:flex; gap:26px; font-family:var(--mono-font); font-size:11px; letter-spacing:.14em; }
  nav.main a{ color:var(--stone); } nav.main a:hover{ color:var(--ink); } nav.main a.on{ color:var(--ink); border-bottom:1px solid var(--oxide); padding-bottom:3px; }
  @media (max-width:800px){ .top{ flex-direction:column; gap:14px; padding:20px 22px; } }
</style>
</head>
<body>
  <header class="top">
    <div class="h">{cabecalho}</div>
    <nav class="main">
      {menu.map((m) => <a href={m.href} class={m.id === ativo ? 'on' : undefined}>{m[lang]}</a>)}
      <a href={outraLingua}>{lang === 'en' ? 'PT' : 'EN'}</a>
    </nav>
  </header>
  <slot />
  <script is:inline src="/no-drag.js"></script>
</body>
</html>
