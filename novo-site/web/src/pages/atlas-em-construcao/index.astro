---
// Atlas em construção: só o aviso, no azul do Atlas (página à parte, fora do menu; o Atlas de verdade está em /atlas/)
import Base from '../../layouts/Base.astro'
import AtlasEmBreve from '../../components/AtlasEmBreve.astro'
import {client} from '../../lib/sanity'
import {coresAtlas} from '../../lib/atlasCores'
const config = await client.fetch(`*[_id=="configAtlas"][0]{corFundo, corTag}`)
const cores = {...coresAtlas(config), '--ink': '#EDEAE2'}
---
<Base titulo="Atlas Fotográfico" cabecalho="ATLAS FOTOGRÁFICO" ativo="atlas" lang="pt" outraLingua="/en/atlas-em-construcao/" cores={cores}>
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <AtlasEmBreve lang="pt" />
</Base>
