---
import Base from '../../../layouts/Base.astro'
import Atlas from '../../../components/Atlas.astro'
import {client} from '../../../lib/sanity'
import {coresAtlas} from '../../../lib/atlasCores'
const config = await client.fetch(`*[_id=="configAtlas"][0]{corFundo, corTag}`)
---
<Base titulo="Photographic Atlas" ativo="atlas" lang="en" outraLingua="/atlas/" cores={coresAtlas(config)} semMenu classe="atlas">
  <link slot="head" rel="stylesheet" href="/atlas.css" />
  <Atlas lang="en" outraLingua="/atlas/" />
</Base>
